# Application Configuration
PORT=8000
HOST=0.0.0.0

# Model Configuration
# Path to local directory containing weights, or Hugging Face model identifier (e.g. t5-small)
MODEL_PATH=./saved_summary_model

# Generation Performance Settings
# Set NUM_BEAMS=1 for fast greedy search (~6-8s on CPU), or 2/4 for beam search
NUM_BEAMS=1
MAX_SUMMARY_LENGTH=100
MIN_SUMMARY_LENGTH=10
TORCH_THREADS=2
